{
  "name": "locallery",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:backend": "bun scripts/start.ts --reload",
    "dev:frontend": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "bun scripts/start.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "test": "bun test tests/history.test.ts && .venv/bin/python -m pytest",
    "lint": "eslint . --max-warnings 0 && .venv/bin/ruff check backend scripts",
    "lint:fix": "eslint . --fix --max-warnings 0 && .venv/bin/ruff check backend scripts --fix",
    "benchmark": ".venv/bin/python -m locallery.benchmark",
    "benchmark:indexing": ".venv/bin/python -m locallery.benchmark_indexing",
    "format": "prettier --write src scripts tests vite.config.ts svelte.config.js eslint.config.js package.json tsconfig.json && .venv/bin/ruff format backend scripts"
  },
  "dependencies": {
    "svelte": "^5.39.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/bun": "^1.3.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte-check": "^4.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.1.7"
  }
}
