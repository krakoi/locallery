{
  "name": "locallery",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:backend": "bun --watch src/backend/server.ts",
    "dev:frontend": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "bun src/backend/server.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "test": "bun test tests",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "benchmark": "bun scripts/benchmark.ts",
    "format": "prettier --write src scripts tests vite.config.ts svelte.config.js eslint.config.js package.json tsconfig.json"
  },
  "dependencies": {
    "sharp": "^0.34.4",
    "svelte": "^5.39.0",
    "usearch": "^2.26.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/bun": "^1.3.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte-check": "^4.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.1.7"
  }
}
